[push]
	default = current
[core]
	excludesfile = /Users/lukas/.gitignore
[color]
	diff = auto
[color.diff]
	newMoved = magenta bold
	oldMoved = magenta bold
[diff]
	colorMoved = plain
[alias]
	co = checkout
[user]
	name = Lukas Osterloh
	email = lukas.osterloh@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
